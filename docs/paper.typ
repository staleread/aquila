#set page(
  paper: "a4",
  margin: (
    top: 20mm,
    bottom: 20mm,
    left: 25mm,
    right: 15mm,
  ),
)

#set par(
  first-line-indent: (
    amount: 1.25cm,
    all: true,
  ),
  justify: true,
  leading: 1.5em,
)

#let fontSize = 14pt;

#set text(
  font: "Times New Roman",
  size: fontSize,
)

